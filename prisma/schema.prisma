// Generated by Prisma — Papa Roma Smoke House

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ADMIN ───────────────────────────────────────────────

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── CLUB MEMBERS ─────────────────────────────────────────

model ClubMember {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  phone        String
  preference   String
  reason       String?
  status       MemberStatus @default(PENDING)
  membershipId String       @unique @default(cuid())
  points       Int          @default(0)
  joinedAt     DateTime     @default(now())
  lastLoginAt  DateTime?
  updatedAt    DateTime     @updatedAt
}

enum MemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

// ─── MENU ─────────────────────────────────────────────────

model MenuType {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String
  icon        String
  logoImage   String?
  order       Int        @default(0)
  categories  Category[]
}

model Category {
  id          String     @id @default(cuid())
  menuTypeId  String
  menuType    MenuType   @relation(fields: [menuTypeId], references: [id], onDelete: Cascade)
  name        String
  nameBn      String?
  description String?
  order       Int        @default(0)
  items       MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  itemId      String?  // original id from menus.json e.g. "sm1"
  name        String
  nameBn      String?
  description String?
  price       Float
  priceAlt    Float?
  unit        String?
  imageUrl    String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── OFFERS ───────────────────────────────────────────────

model Offer {
  id          String    @id @default(cuid())
  title       String
  description String?
  code        String?
  discount    Float     @default(0)
  bannerImage String?
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

// ─── EVENTS & INQUIRIES ───────────────────────────────────

model EventBooking {
  id           String        @id @default(cuid())
  name         String
  email        String
  phone        String
  eventType    String
  eventDate    DateTime
  guests       Int
  instructions String?
  status       BookingStatus @default(PENDING)
  adminNote    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  COMPLETED
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── TESTIMONIALS ─────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  image     String?
  rating    Int      @default(5)
  comment   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─── VIDEOS ───────────────────────────────────────────────

model Video {
  id        String   @id @default(cuid())
  title     String
  youtubeId String
  category  String
  duration  String?
  views     String?
  featured  Boolean  @default(false)
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─── SITE CONFIG (key/value JSON blobs) ───────────────────

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
